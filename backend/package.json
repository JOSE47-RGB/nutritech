{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "db:pull": "prisma db pull",
    "db:generate": "prisma generate",
    "db:check": "node scripts/check-database.cjs",
    "auth:create-admin": "node scripts/create-admin.cjs",
    "test:auth": "RUN_DB_TESTS=1 jest --config ./test/jest-e2e.json --runInBand auth.e2e-spec.ts",
    "test:ninos": "RUN_DB_TESTS=1 jest --config ./test/jest-e2e.json --runInBand ninos.e2e-spec.ts",
    "test:evaluaciones": "RUN_DB_TESTS=1 jest --config ./test/jest-e2e.json --runInBand evaluaciones.e2e-spec.ts",
    "test:patrones": "RUN_DB_TESTS=1 jest --config ./test/jest-e2e.json --runInBand patrones.e2e-spec.ts",
    "references:verify": "node scripts/anthro-import.cjs --files-only",
    "references:plan": "node scripts/anthro-import.cjs",
    "references:import": "node scripts/anthro-import.cjs --apply",
    "test:references": "node --test scripts/anthro-import.test.cjs",
    "test:references:db": "RUN_DB_TESTS=1 node --test scripts/anthro-import.test.cjs",
    "test:nutrition": "jest --runInBand nutrition",
    "nutrition:verify": "ts-node scripts/verify-nutrition.ts",
    "nutrition:oracle": "node scripts/generate-anthro-oracle.mjs",
    "db:migrate:edema": "node scripts/migrate-edema.cjs",
    "classification:review": "ts-node scripts/review-classification.ts",
    "auth:reset-password": "node scripts/reset-password.cjs",
    "db:migrate:orientations": "node scripts/migrate-orientations.cjs",
    "db:migrate:reviews": "node scripts/migrate-reviews.cjs",
    "db:migrate:alerts": "node scripts/migrate-alerts.cjs",
    "db:migrate:reports": "node scripts/migrate-reports.cjs",
    "backup:create": "node scripts/backup.cjs create",
    "backup:verify": "node scripts/backup.cjs verify",
    "test:admin": "RUN_DB_TESTS=1 jest --config ./test/jest-e2e.json --runInBand admin.e2e-spec.ts",
    "backup:test-restore": "node scripts/restore-test.cjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^6.19.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ulid": "^3.0.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "prisma": "^6.19.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "overrides": {
    "multer": "2.4.0",
    "effect": "3.22.2",
    "deepmerge-ts": "8.0.2"
  }
}
