generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model alertas {
 orientacion_id BigInt? @db.UnsignedBigInt
 tipo_aviso String? @db.VarChar(30)
 regla_aviso String? @db.VarChar(100)
 version_politica String? @db.VarChar(50)
 revision Int @default(0) @db.UnsignedInt
 orientacion orientaciones_guardadas? @relation(fields: [orientacion_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_alerta_orientacion")
 @@unique([orientacion_id,regla_aviso,version_politica],map: "uk_alerta_orientacion")
  id                                      BigInt               @id @default(autoincrement()) @db.UnsignedBigInt
  codigo_publico                          String               @unique(map: "uk_alertas_codigo_publico") @db.Char(26)
  resultado_indicador_id                  BigInt?               @unique(map: "uk_alerta_por_resultado") @db.UnsignedBigInt
  nivel                                   alertas_nivel
  titulo                                  String               @db.VarChar(160)
  mensaje                                 String               @db.VarChar(600)
  estado                                  alertas_estado       @default(PENDIENTE)
  generada_en                             DateTime             @default(now())
  asignada_a                              BigInt?              @db.UnsignedBigInt
  revisada_por                            BigInt?              @db.UnsignedBigInt
  revisada_en                             DateTime?
  observacion_revision                    String?              @db.Text
  usuarios_alertas_asignada_aTousuarios   usuarios?            @relation("alertas_asignada_aTousuarios", fields: [asignada_a], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_alertas_asignada")
  resultados_indicador                    resultados_indicador? @relation(fields: [resultado_indicador_id], references: [id], onUpdate: Restrict, map: "fk_alertas_resultado")
  usuarios_alertas_revisada_porTousuarios usuarios?            @relation("alertas_revisada_porTousuarios", fields: [revisada_por], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_alertas_revisor")
  historial_alerta                        historial_alerta[]

  @@index([revisada_por], map: "fk_alertas_revisor")
  @@index([asignada_a, estado, generada_en(sort: Desc)], map: "ix_alertas_asignada")
  @@index([estado, nivel, generada_en(sort: Desc)], map: "ix_alertas_bandeja")
}

model centros_salud {
  id                         BigInt                       @id @default(autoincrement()) @db.UnsignedBigInt
  codigo                     String                       @unique(map: "uk_centros_codigo") @db.VarChar(30)
  nombre                     String                       @db.VarChar(150)
  tipo                       centros_salud_tipo           @default(CAP)
  departamento               String                       @default("Quetzaltenango") @db.VarChar(100)
  municipio                  String                       @default("Génova Costa Cuca") @db.VarChar(100)
  direccion                  String?                      @db.VarChar(255)
  telefono                   String?                      @db.VarChar(25)
  activo                     Boolean                      @default(true)
  creado_en                  DateTime                     @default(now())
  actualizado_en             DateTime                     @default(now())
  evaluaciones_nutricionales evaluaciones_nutricionales[]
  usuarios                   usuarios[]

  @@index([departamento, municipio], map: "ix_centros_ubicacion")
}

model comunidades {
  id              BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  nombre          String   @db.VarChar(120)
  municipio       String   @default("Génova Costa Cuca") @db.VarChar(100)
  departamento    String   @default("Quetzaltenango") @db.VarChar(100)
  zona_referencia String?  @db.VarChar(150)
  activo          Boolean  @default(true)
  creado_en       DateTime @default(now())
  ninos           ninos[]

  @@unique([departamento, municipio, nombre], map: "uk_comunidad_ubicacion")
}

